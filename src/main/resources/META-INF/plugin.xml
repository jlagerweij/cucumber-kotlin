<idea-plugin>
    <id>net.lagerwey.cucumber-kotlin</id>
    <name>Cucumber for Kotlin</name>

    <vendor url="https://www.github.com/jlagerweij">
        Jos Lagerweij
    </vendor>

    <description><![CDATA[
        <p>This plugin enables [Cucumber](https://cucumber.io/) support with step definitions written in Kotlin.</p>

        <p>The following coding assistance features are available:</p>

        <ul>
            <li>Navigation in the source code.</li>
            <li>Create step definitions.</li>
            <li>Run and debug features and scenarios (provided by the Cucumber for Java plugin).</li>
        </ul>
    ]]></description>

    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>gherkin</depends>
    <depends>cucumber-java</depends>

    <extensions defaultExtensionNs="org.jetbrains.plugins.cucumber.steps">
        <cucumberJvmExtensionPoint implementation="net.lagerwey.plugins.cucumber.kotlin.CucumberKotlinLambdaExtension"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <fileBasedIndex implementation="net.lagerwey.plugins.cucumber.kotlin.CucumberKotlinLambdaStepIndex"/>
        <fileBasedIndex implementation="net.lagerwey.plugins.cucumber.kotlin.CucumberKotlinParameterTypeIndex"/>

        <pom.declarationSearcher implementation="net.lagerwey.plugins.cucumber.kotlin.steps.search.CucumberKotlinPomDeclarationSearcher"/>
        <elementDescriptionProvider implementation="net.lagerwey.plugins.cucumber.kotlin.steps.reference.CucumberKotlinParameterPomTargetDescriptionProvider"/>
        <psi.referenceContributor implementation="net.lagerwey.plugins.cucumber.kotlin.steps.reference.CucumberKotlinReferenceContributor"
                                  language="kotlin"/>
        <multiHostInjector implementation="net.lagerwey.plugins.cucumber.kotlin.CucumberKotlinInjector"/>

        <referencesSearch implementation="net.lagerwey.plugins.cucumber.kotlin.steps.search.CucumberKotlinStepDefinitionSearch"/>
        <findUsagesHandlerFactory implementation="net.lagerwey.plugins.cucumber.kotlin.steps.search.CucumberKotlinFindUsagesHandlerFactory"/>
        <usageTypeProvider implementation="net.lagerwey.plugins.cucumber.kotlin.steps.search.CucumberKotlinUsageTypeProvider"/>

        <codeInsight.lineMarkerProvider
            implementationClass="net.lagerwey.plugins.cucumber.kotlin.CucumberKotlinLineMarkerProvider"
            language="kotlin"/>
    </extensions>

</idea-plugin>
